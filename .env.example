FLASK_DATABASE_URL=postgresql+psycopg://flightlog:flightlog@localhost:5433/flightlog

# Shared secrets for signed webhooks. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_GITHUB_WEBHOOK_SECRET=change-me
FLASK_CLAUDE_HOOK_SECRET=change-me

# The hook client (scripts/flightlog_hook.py) does not read this file. Claude Code passes it
# FLIGHTLOG_URL and CLAUDE_HOOK_SECRET from .claude/settings.local.json (not committed):
#   { "env": { "FLIGHTLOG_URL": "http://localhost:5000",
#              "CLAUDE_HOOK_SECRET": "<same value as FLASK_CLAUDE_HOOK_SECRET>" } }
