{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/flightlog_hook.py\"", "async": true, "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/flightlog_hook.py\"", "async": true, "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/flightlog_hook.py\"", "async": true, "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/flightlog_hook.py\"", "async": true, "timeout": 5 }] }
    ]
  }
}
